{% extends 'base.html.twig' %}

{% block title %}{{ article.titre }}{% endblock %}

{% block body %}
    <h1>{{ article.titre }}</h1>

    <p><strong>Auteur :</strong> {{ article.auteur }}</p>
    <p><strong>Date de création :</strong> {{ article.dateCreation ? article.dateCreation|date('d/m/Y à H:i') : '' }}</p>
    <p><strong>Statut :</strong> {{ article.publie ? 'Publié' : 'Brouillon' }}</p>

    <div>
        <p>{{ article.contenu }}</p>
    </div>

    <p>
        <a href="{{ path('app_articles') }}">← Retour à la liste des articles</a>
    </p>
{% endblock %}