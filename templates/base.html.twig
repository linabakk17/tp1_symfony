<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}TP1 Symfony 7.4{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_accueil') }}">TP1 Symfony</a>
            <div class="navbar-nav">
                <a class="nav-link" href="{{ path('app_accueil') }}">Accueil</a>
                <a class="nav-link" href="{{ path('app_articles') }}">Articles</a>
            </div>
        </div>
    </nav>

    <main class="container my-4 flex-grow-1">
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-light text-center py-3 border-top">
        <div class="container">
            <span class="text-muted">TP1 — Introduction au Framework Symfony 7.4</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>